{
  "name": "church-projector",
  "version": "2.4.4",
  "description": "Церква Прага — Панель керування проектором",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win",
    "publish-win": "electron-builder --win --publish always",
    "publish-mac": "electron-builder --mac --publish always",
    "test": "node tools/smoke-test.js",
    "check-i18n": "node tools/check-translation-collisions.js",
    "test-live": "node context-isolation-test.js",
    "test-song-outputs": "node song-outputs-test.js",
    "test-rate-limit": "node rate-limit-test.js",
    "test-remote-double-fire": "node remote-double-fire-test.js",
    "test-band-mode": "node band-mode-test.js",
    "test-song-graphics": "node song-graphics-test.js",
    "test-multitrans-preview": "node multitrans-preview-test.js",
    "test-all-outputs": "node all-outputs-test.js",
    "test-projector-only-default": "node projector-only-default-test.js",
    "test-chroma-song": "node chroma-song-test.js",
    "test-font-lock": "node font-lock-test.js",
    "test-font-max": "node font-max-test.js",
    "test-outputs-improve": "node outputs-improve-test.js",
    "test-scene-preset-outputs": "node scene-preset-outputs-test.js",
    "test-font-max": "node font-max-test.js"
  },
  "build": {
    "appId": "com.church.projector",
    "productName": "Церква Проектор",
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Потрібно для мультивью ATEM через картку захоплення (Виходи → ATEM)."
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${name}-setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "uk_UA",
        "ru_RU",
        "en_US"
      ],
      "language": "1058"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "churchprogramcz-eng",
        "repo": "church-projector"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "playwright": "^1.47.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.1.0",
    "ffmpeg-static": "^5.2.0",
    "heic-convert": "^2.1.0",
    "qrcode": "^1.5.3",
    "ws": "^8.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/churchprogramcz-eng/church-projector.git"
  },
  "optionalDependencies": {
    "atem-connection": "^3.8.0",
    "onvif": "^0.7.1"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
